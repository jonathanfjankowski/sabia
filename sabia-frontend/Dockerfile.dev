# Dev Dockerfile for React frontend — bind-mount friendly, runs Vite dev server
FROM node:22-alpine

WORKDIR /app

# Install deps first (cached layer). Source is bind-mounted on top.
COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]