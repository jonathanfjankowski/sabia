APP_NAME=Sabiá
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.seudominio.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sabia
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
# Laravel 11+ lê CACHE_STORE (CACHE_DRIVER é ignorado)
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Sanctum SPA
SANCTUM_STATEFUL_DOMAINS=seudominio.com,www.seudominio.com
SESSION_DOMAIN=seudominio.com

# CORS + Security
ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com
SECURITY_HEADERS_ENABLED=true

# AI Settings (configurável via Admin → Settings → IA)
# AI_PROVIDER=openai
# AI_ENDPOINT=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=2048
# AI_SYSTEM_PROMPT="Você é um assistente de suporte. Responda APENAS perguntas baseadas na base de conhecimento fornecida. Responda sempre em markdown."
# AI_CHUNK_SIZE=500
# AI_CHUNK_OVERLAP=100
# AI_RAG_TOP_N=5
# AI_CONFIDENCE_THRESHOLD=0.35
# AI_LANGUAGE=pt-BR

# Embedding sidecar (BAAI/bge-m3, 1024 dims) — ver docs/arquitetura.md.
# Endereço interno do compose. Em dev local sem compose: http://localhost:8001.
EMBEDDING_URL=http://embedding-sidecar:8000
# Token compartilhado com o sidecar (opcional; o sidecar lê EMBEDDING_SIDECAR_TOKEN)
# EMBEDDING_TOKEN=

# Mail (opcional)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"